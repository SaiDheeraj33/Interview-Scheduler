# Postgres connection string. Leave unset for local development: the app then uses an
# embedded Postgres (PGlite) stored in ./data, with no server to install.
#
# Production (Supabase): Project → Connect → "Transaction pooler" (port 6543), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
